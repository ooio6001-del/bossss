# Optional API keys. Leave blank to use only free keyless sources
# (DexScreener, GeckoTerminal, public Solana RPC).
# Copy this file to .env and fill in values locally. Never commit .env.
# Keys are read server-side from the environment only; they must not be
# logged, written to snapshots, or embedded in dashboards.
BIRDEYE_API_KEY=
HELIUS_API_KEY=
